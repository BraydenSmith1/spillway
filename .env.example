# Copy this file to .env and fill in your own values:
#     cp .env.example .env
# .env is gitignored and must NEVER be committed.

# --- ERCOT Public API ---
# Register for free at https://apiexplorer.ercot.com/
# Wrap values in single quotes if they contain special characters.
ERCOT_USERNAME='your_ercot_login_email'
ERCOT_PASSWORD='your_ercot_password'
ERCOT_SUBSCRIPTION_KEY='your_api_subscription_key'

# --- TimescaleDB (started by docker-compose.yml) ---
# Port is 5433 on the host to avoid clashing with a local Postgres on 5432.
PGHOST=localhost
PGPORT=5433
PGDATABASE=spillway
PGUSER=spillway
PGPASSWORD=pick_a_password
